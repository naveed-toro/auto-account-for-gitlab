{
  "manifest_version": 3,
  "name": "Auto Account for GitLab",
  "version": "1.0.0",
  "description": "Remembers several gitlab.com accounts and opens every link with the account that has access to it.",
  "permissions": ["cookies", "storage", "webRequest"],
  "host_permissions": ["https://gitlab.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Auto Account for GitLab",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
